{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "india-food-ad-scraper",
  "main": "src/index.js",
  "workers_dev": true,
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "limits": {
    "cpu_ms": 300000
  },
  "ai": {
    "binding": "AI"
  },
  "media": {
    "binding": "MEDIA"
  },
  "triggers": {
    "crons": [
      "30 0 * * MON,THU",
      "0 1 * * MON,THU",
      "30 1 * * MON,THU",
      "0 2 * * MON,THU",
      "30 2 * * MON,THU",
      "0 3 * * MON,THU",
      "30 3 * * MON,THU",
      "0 4 * * MON,THU"
    ]
  },
  "browser": {
    "binding": "BROWSER"
  }
}
