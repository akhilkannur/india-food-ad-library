{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "india-food-ad-scraper",
  "main": "src/index.js",
  "workers_dev": true,
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  "media": {
    "binding": "MEDIA"
  },
  "triggers": {
    "crons": [
      "15 5 * * *",
      "30 1 * * *",
      "30 7 * * *",
      "30 13 * * *",
      "30 19 * * *"
    ]
  },
  "browser": {
    "binding": "BROWSER"
  }
}
