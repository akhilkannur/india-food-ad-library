# Public Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=

# Canonical public URL used for metadata, sitemap and canonical tags
NEXT_PUBLIC_SITE_URL=

# Server-only Supabase service role key. Never expose this in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Single-admin credentials for the moderation backend.
ADMIN_EMAIL=
ADMIN_PASSWORD=
AUTH_SECRET=
